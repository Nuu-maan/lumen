{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumen",
  "version": "0.1.0",
  "identifier": "app.lumen.viewer",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' lumen: http://lumen.localhost data: blob:; style-src 'self' 'unsafe-inline'; frame-src 'self' blob: data:; connect-src ipc: http://ipc.localhost lumen: http://lumen.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "dmg",
      "app",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Lumen",
    "category": "Productivity",
    "shortDescription": "Fast, high-fidelity document viewer",
    "longDescription": "Lumen opens PDF, Office, e-book, email, text and image files and shows them as the author made them.",
    "license": "AGPL-3.0-or-later",
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF document",
        "description": "PDF document",
        "role": "Viewer",
        "mimeType": "application/pdf"
      },
      {
        "ext": [
          "xps",
          "oxps"
        ],
        "name": "XPS document",
        "description": "XPS document",
        "role": "Viewer",
        "mimeType": "application/oxps"
      },
      {
        "ext": [
          "epub",
          "mobi",
          "azw3",
          "fb2",
          "cbz"
        ],
        "name": "E-book",
        "description": "E-book",
        "role": "Viewer",
        "mimeType": "application/epub+zip"
      },
      {
        "ext": [
          "docx",
          "docm",
          "dotx",
          "doc",
          "rtf",
          "odt"
        ],
        "name": "Word document",
        "description": "Word document",
        "role": "Viewer",
        "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
      },
      {
        "ext": [
          "xlsx",
          "xlsm",
          "xlsb",
          "xls",
          "ods",
          "csv"
        ],
        "name": "Spreadsheet",
        "description": "Spreadsheet",
        "role": "Viewer",
        "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
      },
      {
        "ext": [
          "pptx",
          "ppsx",
          "ppt",
          "pps",
          "odp"
        ],
        "name": "Presentation",
        "description": "Presentation",
        "role": "Viewer",
        "mimeType": "application/vnd.openxmlformats-officedocument.presentationml.presentation"
      },
      {
        "ext": [
          "vsdx",
          "vsd"
        ],
        "name": "Visio drawing",
        "description": "Visio drawing",
        "role": "Viewer",
        "mimeType": "application/vnd.ms-visio.drawing"
      },
      {
        "ext": [
          "pub",
          "wpd",
          "hwp",
          "pages",
          "numbers",
          "key"
        ],
        "name": "Other document",
        "description": "Document",
        "role": "Viewer"
      },
      {
        "ext": [
          "eml",
          "msg",
          "mht",
          "mhtml"
        ],
        "name": "Email message",
        "description": "Email message",
        "role": "Viewer",
        "mimeType": "message/rfc822"
      },
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown",
        "description": "Markdown document",
        "role": "Viewer",
        "mimeType": "text/markdown"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": [],
        "desktopTemplate": "lumen.desktop"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}